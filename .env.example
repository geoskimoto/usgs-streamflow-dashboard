# DataOps Adapter Selection
# true  (default) — use REST API via DataOpsAdapter (Render, any remote host)
# false           — use direct PostgreSQL via DirectDBAdapter (same-server deployment)
USE_DATAOPS_API=true

# DataOps REST API Configuration (used when USE_DATAOPS_API=true)
DATAOPS_API_URL=https://streamflowops.3rdplaces.io
DATAOPS_API_TOKEN=
DATAOPS_VERIFY_SSL=true
DATAOPS_CACHE_ENABLED=true
DATAOPS_CACHE_TTL=300
DATAOPS_TIMEOUT=30

# Direct PostgreSQL Configuration (used when USE_DATAOPS_API=false)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=streamflow_db
DB_USER=streamflow_user
DB_PASSWORD=

# ResidCast ML Forecast Integration
# true  — enable ResidCast forecast series on the water year plot
USE_RESID_CAST=false
# true  — fetch via REST API; false — query PostgreSQL directly (same-server deployment)
RESID_CAST_USE_API=false
# REST API configuration (used when RESID_CAST_USE_API=true)
RESID_CAST_API_URL=https://resid-cast.3rdplaces.io
RESID_CAST_API_TOKEN=
# Direct PostgreSQL URL (used when RESID_CAST_USE_API=false)
# Format: postgresql://user:password@host:port/dbname
RESID_CAST_DB_URL=postgresql://user:password@127.0.0.1:5432/resid_cast_db

# NWRFC Web Forecast Integration
# Set true to use NWRFC website scraper forecasts (10-day horizon) with NOAA API fallback
USE_NWRFC_WEB_FORECASTS=false

# Dashboard Settings
DEBUG_MODE=false
ENABLE_LEGACY_ADMIN=true
