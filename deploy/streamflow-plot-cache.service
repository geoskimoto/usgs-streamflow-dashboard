[Unit]
Description=Rebuild USGS streamflow plot cache (NWRFC forecast stations)
After=network.target

[Service]
Type=oneshot
User=streamflowdash
WorkingDirectory=/home/streamflowdash/htdocs/dashboard.streamflows.org
ExecStart=/home/streamflowdash/htdocs/dashboard.streamflows.org/.venv/bin/python \
    manage_cache.py rebuild_plots --workers 4
StandardOutput=journal
StandardError=journal
